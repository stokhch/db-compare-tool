{
  "name": "db-compare-tool",
  "version": "1.0.0",
  "description": "Сравнение и копирование баз данных Oracle / PostgreSQL",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "setup": "npm install && npm --prefix client install && npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "express": "^4.21.2",
    "oracledb": "^6.7.0",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "pg-cursor": "^2.12.1"
  }
}
